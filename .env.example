# ==============================================================================
# HackJudge Environment Configuration Template
# Copy this file to .env and configure for your local or production deployment.
# NEVER commit .env to version control.
# ==============================================================================

# Database Configuration
# PostgreSQL (Default for Docker): postgresql://hackathon_user:CHANGE_ME@database:5432/hackathon_db
# SQLite (Local file-based development): sqlite:///./hackathon.db
DATABASE_URL=sqlite:///./hackathon.db

# Security & Authentication
# Replace with a cryptographically secure random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY_FOR_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=development
PORT=8000
FRONTEND_PORT=5173

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:80"]

# Feature Flags
# OFFLINE_MODE=true guarantees zero external telemetry, cloud auth, or CDN dependencies
OFFLINE_MODE=true
# AUTO_SEED=true automatically initializes fixture accounts and Dogfood competition records
AUTO_SEED=true
